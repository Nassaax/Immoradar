# ─────────────────────────────────────────────────────────────
# ListingRadar — variables d'environnement
# Copiez ce fichier vers .env (local) ou configurez ces valeurs
# dans le dashboard Vercel (Settings > Environment Variables).
# ─────────────────────────────────────────────────────────────

# Base de données Postgres (Supabase, Neon, ou toute instance Postgres).
# Utilisez l'URL "pooled" pour DATABASE_URL et l'URL directe pour DIRECT_URL
# (nécessaire pour les migrations Prisma avec un pooler type pgbouncer).
DATABASE_URL="postgresql://user:password@host:5432/listingradar?schema=public&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host:5432/listingradar?schema=public"

# Mot de passe de l'espace admin (/admin). Choisissez une valeur longue et aléatoire.
ADMIN_PASSWORD="change-me-please-use-a-long-random-value"

# Secret utilisé pour signer le cookie de session admin (HMAC). Générez avec:
# openssl rand -hex 32
ADMIN_SESSION_SECRET="change-me-64-hex-chars"

# Secret partagé avec Vercel Cron pour authentifier les appels aux routes
# /api/cron/*. Vercel envoie automatiquement l'en-tête
# "Authorization: Bearer $CRON_SECRET" pour les cron jobs configurés dans
# vercel.json si cette variable est définie. Générez avec: openssl rand -hex 32
CRON_SECRET="change-me-64-hex-chars"

# Email sortant (alertes) via Resend (https://resend.com). Laissez vide en
# local pour désactiver l'envoi réel (les emails seront loggés en console).
RESEND_API_KEY=""
ALERTS_FROM_EMAIL="ListingRadar <alertes@listingradar.example>"

# URL publique du site, utilisée pour générer les liens absolus dans les
# emails (désinscription, gestion d'alerte, etc.).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Adresse de contact affichée dans le User-Agent du crawler et sur la page
# Opt-out, pour que les agences puissent nous contacter.
CRAWLER_CONTACT_EMAIL="contact@listingradar.example"

# Délai minimum (ms) entre deux requêtes vers un même nom de domaine.
# 1000 = 1 requête/seconde/domaine, conforme à une politique de crawl polie.
CRAWLER_MIN_DELAY_MS="1000"
